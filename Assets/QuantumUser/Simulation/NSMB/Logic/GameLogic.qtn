#define MaxPlayers 10
#pragma max_players MaxPlayers

global {
	GameRules Rules;	
	GameState GameState;
	int StartFrame;
	int TotalGamesPlayed;
	ushort GameStartFrames;
	ushort PlayerLoadFrames;
	ushort AutomaticStageRefreshInterval;
	ushort AutomaticStageRefreshTimer;

	array<PlayerInformation>[MaxPlayers] PlayerInfo;
	byte RealPlayers;
	byte TotalMarios; // Different from RealPlayers- count of all Marios at game start, including ones baked into the scene.

	int WinningTeam;
	bool HasWinner;

	
	GameRules ClipboardRules;
}

struct PlayerInformation {
	PlayerRef PlayerRef;
	QString<48> Nickname;
	QStringUtf8<48> NicknameColor;
	byte Team;
	AssetRef<CharacterAsset> Character;
	bool Disconnected;
	bool Disqualified;
}

struct GameRules {

	//KKT Mod
	bool AdvancedLobby;
	AssetRef<Map> Stage;
	AssetRef<GamemodeAsset> Gamemode;
	int StarsToWin; //coinrunner's coins, balloon battle's balloons
	byte StarFrequency; //coinrunner's starcoin frequency
	//bool GamemodeBombchasersEnabled;

    //Stage Coins Group
    bool ModifierCoinsEnabled;
    int CoinsForPowerup;
	bool RouletteBlocksEnabled; //the stage might have to commit to one ? block type, perhaps store it in the stage asset, this will also be used for the disabling of coins
	[AllocateOnComponentAdded, FreeOnComponentRemoved] list<ItemList> Items;

    //Hazards Group
    bool ModifierHazardsEnabled;
    byte MaxHazards; //10 1-30
    byte HazardFrequency;
    FP HeftyPercentage; //0.12
    int HazardLifetime;
	[AllocateOnComponentAdded, FreeOnComponentRemoved] list<HazardList> Hazards;

    //Lives Group
    bool ModifierLivesEnabled;
    int Lives;

    //Timer Group
    bool ModifierTimerEnabled;
    int TimerMinutes;
	//TODO: time up behavior

	//Teams Group
	bool ModifierTeamsEnabled;
    //TODO: Spawn Teams Together Separate from foes

    //Bulb
    bool ModifierBulbEnabled;
    byte BulbAbilityCount; //The Amount Of Options Bulb Has, 0-3
	bool HostControl; //only the host can choose what the bulb does

    //Extras/Experimental Group
    bool ModifierExtrasEnabled;
    bool DisableStageRestrictions; //disables restrictions stages have (banned hazards, forced character) 
    bool DisableComplexStageRestrictions; //disables restrictions in the complex stage category, this comes with a warning
    bool EveryItemHasTheSameChance; //every item is labeled under middling, insanity occurs
    //bool DisableSpecialUnlocks; //disables the ability to use special unlockables, this is to prevent players from using the unlockables in weird ways --- this one is GOOD
	//bool DisableReserve; //disables all Reverse functionality
    //bool PlayersSpawnFromPipes;
    //bool HideMinimap; //enabled ghost house minimap
    //bool RemoveStageHazards; //removes stage hazards ??? like should we remove everything fortressmovers to enemies?

    /*
	AssetRef<Map> Stage;
	AssetRef<GamemodeAsset> Gamemode;

	bool StarsEnabled;
	int StarsToWin;
	int CoinsForPowerup;
	AssetRef<CurrentHazards> CurrentRuleData;
	int Lives;
	int TimerMinutes;
	bool TeamsEnabled;
	*/
}

enum GameState : Byte {
    PreGameRoom,
    WaitingForPlayers,
    Starting,
    Playing,
    Ended
}

struct ItemList {
	ItemChanceType Chance;
	[AllocateOnComponentAdded, FreeOnComponentRemoved] list<PowerupData> Items;
}
struct PowerupData {
//Base
    QString<64> Name;
    AssetRef<EntityPrototype> PowerupPrototype;
//Sub Data
    byte Team;
    //FP Scale;
//Specific Data
    ExtrasList Extra;
}

struct HazardList {
    QString<64> Name;
    AssetRef<EntityPrototype> HazardPrototype;
//Sub Data
    byte Team;
    bool Hefty;
    bool SpawnRandom;
    bool SpawnFridge;
    //FP Scale;
//Specific Data
	ExtrasList Extra;
}

struct ExtrasList {
    [AllocateOnComponentAdded, FreeOnComponentRemoved] list<byte> Extra;
}

enum ItemChanceType : Byte {
    First,
	Middling,
	LastCommon,
	LastRare,
	JokeFirst,
	JokeMiddle,
	Bulb,
	Invalid,
}

signal OnLoadingComplete();
signal OnGameStarting();
signal OnGameEnding(int winningTeam, bool hasWinner);
signal OnReturnToRoom();

synced event GameStateChanged {
	GameState NewState;
}

synced event PlayerAdded {
	PlayerRef Player;
}

synced event PlayerRemoved {
	PlayerRef Player;
}

event PlayerDataChanged {
	PlayerRef Player;
}

synced event StartingCountdownChanged {
	bool IsGameStarting;
}

event CountdownTick {
	int SecondsRemaining;
}

synced event HostChanged {
	PlayerRef NewHost;
}

synced event RulesChanged {
	bool GamemodeChanged;
	bool MapChanged;
}

synced event HostCloseRulesPanel {

}

synced event PlayerLoaded {
	PlayerRef Player;
}

synced event RecordingStarted {

}

synced event GameStarted {

}

synced event GameEnded {
	bool EndedByHost;
	int WinningTeam;
	bool HasWinner;
}

event StartGameEndFade {

}

synced event StageAutoRefresh {

}