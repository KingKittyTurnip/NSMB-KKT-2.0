#define MaxPlayers 10
#pragma max_players MaxPlayers

global {
	GameRules Rules;	
	GameState GameState;
	int StartFrame;
	int TotalGamesPlayed;
	ushort GameStartFrames;
	ushort PlayerLoadFrames;
	ushort AutomaticStageRefreshInterval;
	ushort AutomaticStageRefreshTimer;

	array<PlayerInformation>[MaxPlayers] PlayerInfo;
	byte RealPlayers;
	byte TotalMarios; // Different from RealPlayers- count of all Marios at game start, including ones baked into the scene.

	int WinningTeam;
	bool HasWinner;
}

struct PlayerInformation {
	PlayerRef PlayerRef;
	QString<48> Nickname;
	QStringUtf8<48> NicknameColor;
	byte Team;
	AssetRef<CharacterAsset> Character;
	bool Disconnected;
	bool Disqualified;
}

struct GameRules {

	//KKT Mod
	bool AdvancedLobby;
	AssetRef<Map> Stage;
	AssetRef<GamemodeAsset> Gamemode; //this is supposed to be unused but way too much things rely on it so i don't want to remove it to make merges easily compatable
	bool GamemodeStarChasersEnabled;
	  int StarsToWin;
	  int starfrequency;
	bool GamemodeCoinRunnersEnabled;
	  int starcoinfrequency;
	bool GamemodeBalloonBattleEnabled;
	  byte MaxBalloons;
	bool GamemodeBombchasersEnabled;

	int CoinsForPowerup;
	//ItemMenu; //??
	
	bool HazardsEnabled;

	int Lives;

	int TimerMinutes;

	bool TeamsEnabled;

	/*
	AssetRef<Map> Stage;
	AssetRef<GamemodeAsset> Gamemode;

	bool StarsEnabled;
	int StarsToWin;
	int CoinsForPowerup;
	AssetRef<CurrentHazards> CurrentRuleData;
	int Lives;
	int TimerMinutes;
	bool TeamsEnabled;
	*/
}

enum GameState : Byte {
    PreGameRoom,
    WaitingForPlayers,
    Starting,
    Playing,
    Ended
}

signal OnLoadingComplete();
signal OnGameStarting();
signal OnGameEnding(int winningTeam, bool hasWinner);
signal OnReturnToRoom();

synced event GameStateChanged {
	GameState NewState;
}

synced event PlayerAdded {
	PlayerRef Player;
}

synced event PlayerRemoved {
	PlayerRef Player;
}

event PlayerDataChanged {
	PlayerRef Player;
}

synced event StartingCountdownChanged {
	bool IsGameStarting;
}

event CountdownTick {
	int SecondsRemaining;
}

synced event HostChanged {
	PlayerRef NewHost;
}

synced event RulesChanged {
	bool GamemodeChanged;
	bool MapChanged;
}

synced event HostCloseRulesPanel {

}

synced event PlayerLoaded {
	PlayerRef Player;
}

synced event RecordingStarted {

}

synced event GameStarted {

}

synced event GameEnded {
	bool EndedByHost;
	int WinningTeam;
	bool HasWinner;
}

event StartGameEndFade {

}

synced event StageAutoRefresh {

}