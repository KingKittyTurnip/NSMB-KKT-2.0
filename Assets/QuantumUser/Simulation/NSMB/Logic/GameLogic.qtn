enum TeamAttackOptions : Byte {
	None,
	KnockbackOnly,
	Full
}

enum GameState : Byte {
    PreGameRoom,
    WaitingForPlayers,
    Starting,
    Playing,
    Ended
}

struct HazardList {
	int PrototypeRef;
    //AssetRef<EntityPrototype> HazardPrototype;
	//Sub Data
    byte Team;
    //FP Scale;
	//Specific Data
    byte ExtraSlotA;
    byte ExtraSlotB;
    byte ExtraSlotC;
    byte ExtraSlotD;
}

enum ItemChanceType : Byte {
    First,
	Middling,
	LastCommon,
	LastRare,
	Joke,
	Bulb,
	Invalid,
}

signal OnLoadingComplete();
signal OnGameStarting();
signal OnGameEnding(int winningTeam, bool hasWinner);
signal OnReturnToRoom();

synced event GameStateChanged {
	GameState NewState;
}

synced event PlayerAdded {
	PlayerRef Player;
}

synced event PlayerRemoved {
	PlayerRef Player;
}

event PlayerDataChanged {
	PlayerRef Player;
}

synced event StartingCountdownChanged {
	bool IsGameStarting;
}

event CountdownTick {
	int SecondsRemaining;
}

synced event HostChanged {
	PlayerRef NewHost;
}

synced event RulesChanged {
	bool GamemodeChanged;
	bool MapChanged;
}

synced event RandomStageToggled {
	AssetRef<Map> Stage;
	bool IsDisabled;
}

synced event CoinItemCustomSpawnWeightChanged {
	AssetRef<CoinItemAsset> CoinItem;
	FP NewWeight;
}

synced event HostCloseRulesPanel {

}

synced event PlayerLoaded {
	PlayerRef Player;
}

synced event RecordingStarted {

}

synced event GameStarted {

}

synced event GameEnded {
	bool EndedByHost;
	int WinningTeam;
	bool HasWinner;
}

event StartGameEndFade {

}

synced event StageAutoRefresh {

}

//KKT Mod
synced event HazardListChanged {
    Frame Frame;
	byte NewHazardId;
	bool IsItems;
}