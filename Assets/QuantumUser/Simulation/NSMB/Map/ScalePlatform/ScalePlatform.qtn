component ScalePlatform {
	FP Length;
	FP Height;
	FP Startoffset;
	FP TerminalVelocity;
	FP Acceleration;
	FP PlatformbreakTime;
	
	[ExcludeFromPrototype] bool IsFalling;
	[ExcludeFromPrototype] ushort Timer;
	[ExcludeFromPrototype] FP Velocity;
	[ExcludeFromPrototype] FP Offset;
	
	[ExcludeFromPrototype] int Delay;
    [ExcludeFromPrototype] int WeightOnLift;
    [ExcludeFromPrototype] bool WeightIsEven;
}

event ScaleplatformStepped {
    EntityRef Entity;
	bool IsRightPlatform;
	bool Broken;
}