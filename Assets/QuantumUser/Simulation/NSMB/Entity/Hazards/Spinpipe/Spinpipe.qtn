global {
	FP SpinpipeSlope;
	FP SpinpipeMAX;
}

component Spinpipe {
	bool Sturdy;
	bool Broken;
	
	[ExcludeFromPrototype] bool Right;
	[ExcludeFromPrototype] int TipTime;
	[ExcludeFromPrototype] bool Active;

	[ExcludeFromPrototype] byte groundDelay;
}

event SpinpipeLand {
	EntityRef Entity;
	bool Despawn;
}

event SpinpipeDestroy {
	Frame f;
	EntityRef Entity;
	bool Right;
}