component ThrowingObject {
    ThrowingObjectType Type;
    bool GroundBounce;
    bool SlideAlong;
	bool BouceOffPlayer;
	FP ThrowForce;

	byte StarsToDrop;
	bool IgnoreTeamates;

	[ExcludeFromPrototype] bool Thrown;
	[ExcludeFromPrototype] bool CanHit;
	[ExcludeFromPrototype] bool Facing;
	[ExcludeFromPrototype] byte BounceTimes;

	[ExcludeFromPrototype] FP ReusableTimer;
}

enum ThrowingObjectType : Byte {
    Basic,
	Stone, // For Particle When Landing
	Spring, // For Spring Effect
	RedPow, // For Explosion
	BluePow, // For Grounded Explosion
	Barrel, // For Damage
	Freezie, // For Freeze And Split Effect
	CoinBox, // For Coin Giving
	PropellerBox, // For Flying
	BillBlock, // For Gliding
	CannonBox, // For Pewing
	Fridge, // For pinata
	Potion, // For Creating WarpDoor
}

event ThrowObjSimple {
	EntityRef Entity;
	FPVector2 pos;
}