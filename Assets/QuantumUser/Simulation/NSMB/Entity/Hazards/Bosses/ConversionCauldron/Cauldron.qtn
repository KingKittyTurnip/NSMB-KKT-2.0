component Cauldron {
	byte ConvertIntoBossId;
	FP Hitboxheight;
	
	AssetRef<SpecificHazardContainerAsset> BossData;
	
	[ExcludeFromPrototype] EntityRef TransformingEntity;
	[ExcludeFromPrototype] byte EnteredFrames;
	[ExcludeFromPrototype] bool Activated;
}

synced event CauldronSplash {
	EntityRef Entity;
}

synced event CauldronHop {
	EntityRef Entity;
}

synced event CauldronExpand {
	EntityRef Entity;
}