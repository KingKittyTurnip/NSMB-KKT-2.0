component KingBoo {
	KingBooState State;
	AssetRef<EntityPrototype> BlueFire;

	[ExcludeFromPrototype] byte ReusableTimer;
	
	[ExcludeFromPrototype] byte ProjectileShots;

	//ai vars
	[ExcludeFromPrototype] byte waitTime;
	[ExcludeFromPrototype] byte RngFireball;
	[ExcludeFromPrototype] bool NeedsNewTarget;
	[ExcludeFromPrototype] FPVector2 TargetPosition;
}

enum KingBooState : Byte {
    Laughing,
	Floating,
	Teleporting,
	Barfing,
	Sucking,
	Knockback,
}
