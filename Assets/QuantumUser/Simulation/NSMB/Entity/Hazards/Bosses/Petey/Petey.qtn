component Petey {
	PeteyState State;
	AssetRef<EntityPrototype> StandardSpinAttack;
	
	[ExcludeFromPrototype] bool Flying;
	[ExcludeFromPrototype] FP PreviousLandLevel;
	[ExcludeFromPrototype] byte ReusableTimer;
	[ExcludeFromPrototype] bool HitATarget;
	FPVector2 Hitbox;
	FPVector2 FallenBox;

	//ai vars
	[ExcludeFromPrototype] byte JumpCounter;
}

enum PeteyState : Byte {
    Idling,
	Jumping,
	Flying,
	Diving,
	Fallen,
	//Player Specific(?)
	MeleeAttack,
}

event PeteyWakeup {
	EntityRef Entity;
	bool Interupted;
}
synced event PeteyGetUp {
	EntityRef Entity;
}
synced event PeteyJump {
	EntityRef Entity;
}
event PeteyDive {
	EntityRef Entity;
}
synced event PeteyLanded {
	EntityRef Entity;
	bool Weakened;
}
synced event PeteyStomped {
	EntityRef Entity;
	bool IsDeath;
}
event PeteyAttack {
	EntityRef Entity;
}