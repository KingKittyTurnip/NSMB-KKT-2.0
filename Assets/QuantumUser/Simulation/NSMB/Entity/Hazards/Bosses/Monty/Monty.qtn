#define _0_005 0.005
#define _7_50 7.50

component Tank {
    MontyState State;
    AssetRef<EntityPrototype> MolePrototype;
    AssetRef<EntityPrototype> SegmentPrototype;
    AssetRef<EntityPrototype> BulletBillPrototype;
    AssetRef<EntityPrototype> BombudPrototype;

    //jump logic
    [ExcludeFromPrototype] byte ReusableTimer;

    [ExcludeFromPrototype] EntityRef MoleEntity;
    [ExcludeFromPrototype] EntityRef SegmentEntity;

    //cannon vars
    [ExcludeFromPrototype] byte CannonActionCooldown;

    [ExcludeFromPrototype] byte SegmentNumber;
    [ExcludeFromPrototype] byte SegmentCreationTimer;
    
    //cannon segment vars
	[ExcludeFromPrototype] array<FP>[3] FacingDirection;
	[ExcludeFromPrototype] array<CannonDecision>[3] CurrentAction;
    array<FPVector3>[3] CannonOffset;
    array<FP>[3] MoleSeats;

    //monty vars
    [ExcludeFromPrototype] byte AttackCooldown;
    [ExcludeFromPrototype] FP LastMontyPos;

    //ai vars
    [ExcludeFromPrototype] byte waitTime;
    [ExcludeFromPrototype] int decideSegmentTimer;
}

component Monty {
    //used for interactions
    [ExcludeFromPrototype] EntityRef OwnerEntity;
}

enum MontyState : Byte {
    ReadyUp,
    Walking,
    ChargeJump,
    Jumping,
	Knockbacked,
}

enum CannonDecision : Byte {
    //this is so stupid LMAO
    None,
    TurnDelayLA,
    TurnDelayLB,
    TurnDelayLC,
    TurnDelayLD,
    TurnLeft,
    TurnDelayRA,
    TurnDelayRB,
    TurnDelayRC,
    TurnDelayRD,
    TurnRight,
    FireA,
    FireB,
    FireC,
    FireD,
    FireE,
    FireF,
    FireG,
    FireH,
    FireI,
    FireJ,
    FireK,
    FireL,
    FireFin,
}

event TankCannonPrepareFire {
    EntityRef Entity;
    byte SegmentId;
}

event TankCannonFire {
    EntityRef Entity;
    byte SegmentId;
}

event TankPrepareJump {
    EntityRef Entity;
}

event TankMontyAttack {
    EntityRef Entity;
    bool Thrown;
}

event TankAddRemoveSegment {
    EntityRef Entity;
    byte SegmentId;
    bool IsAdding;
}

event TankStartTurn {
    EntityRef Entity;
    byte SegmentId;
    bool IsStarting;
}