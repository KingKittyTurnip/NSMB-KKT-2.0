
#define _0_12 0.12

component Fan {
	FP Strength;
	FP Cooldown;
	bool Broken;
	bool FellOver;
	bool Sturdy;
	bool HandleParticles;
	
	[ExcludeFromPrototype] FP CurrentStrength;
	[ExcludeFromPrototype] bool FacingRight;
	[ExcludeFromPrototype] int FanTime;
	[ExcludeFromPrototype] byte TurnEffectorDowntime;
}

event OnFanHit {
	EntityRef Entity;
	bool Broken;
}

event OnFanSwitch {
	EntityRef Entity;
	bool SwitchOn;
}