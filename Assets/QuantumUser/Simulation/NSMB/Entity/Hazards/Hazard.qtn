//import struct HazardList;

component Hazard {
  //General
	[ExcludeFromPrototype] bool IsCoinItem;
	[ExcludeFromPrototype] bool IsHazard;
	//FPVector2 Spawnpoint;
	//[ExcludeFromPrototype] bool IsActive;
	bool DoNotDespawnInPit;

  //HazardSpawn Vars
	bool RestrictSpawnPosition;
	bool IsHefty;
	bool IPWSUntilGround;
	byte IPWSTime;
	FPVector2 SpawningVelocityRange;

  //Specifics
	[ExcludeFromPrototype] byte Team;
	[ExcludeFromPrototype] int BaseLifeTime;
	[ExcludeFromPrototype] int LifeTime;
	[ExcludeFromPrototype] bool JustSpawned;
	[ExcludeFromPrototype] byte index;
}

enum SpawnReason : Byte {
	Normal,
	Bulb,
	Fridge,
	Forced, //used for objects that are created outside of the hazardlist
	WasCreatedFromNested, //used for objects that Can be nested Endlessly

	Item, //used for items
}

signal InitializeHazard(EntityRef thisEntity, EntityRef owner, FPVector2 spawnpoint, SpawnReason spawnReason, list<byte> spawnData);

event PlayPuffParticle {
	FPVector2 Position;
}