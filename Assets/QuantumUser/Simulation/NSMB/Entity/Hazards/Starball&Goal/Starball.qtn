component Starball {
	AssetRef<EntityPrototype> Contains;
	
	[ExcludeFromPrototype] byte JumpBufferFrames;
	[ExcludeFromPrototype] byte CoyoteTimeFrames;

	[ExcludeFromPrototype] EntityRef Rider;
	[ExcludeFromPrototype] EntityRef Goal;
}

event StarBallDestroyed {
	EntityRef Entity;
}

event StarBallLand {
	Frame f;
	EntityRef Entity;
	bool Hard;
}