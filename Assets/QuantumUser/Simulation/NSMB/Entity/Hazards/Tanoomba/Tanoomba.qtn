#define _0_875 0.875

component Tanoomba {
	[ExcludeFromPrototype] TanoombaState State;
	[ExcludeFromPrototype] int FormId;
	[ExcludeFromPrototype] byte FormVariant;
	[ExcludeFromPrototype] bool TransformIntoAnythingAnytime;
	FP JumpVelocity;
	FPVector2 BaseGravity;
	FP BaseTerminalVelocity;
	
	[ExcludeFromPrototype] FP ReusableTimer;

	[ExcludeFromPrototype] EntityRef TransformedObject;
	[ExcludeFromPrototype] EntityRef TargetedPlayer;
	
	//[ExcludeFromPrototype] bool Laughing;
	[ExcludeFromPrototype] bool PlayerPassedBy;
	[ExcludeFromPrototype] bool Invulnrable;

	//transform data stuff
	AssetRef<TanoombaTransformationAsset> FormData;
	[ExcludeFromPrototype] FP AnimationCurveTimer;
	[ExcludeFromPrototype] FPVector2 AnimationCurveOrigin;
	AssetRef<PowerupAsset> PropellerAsset;
	AssetRef<PowerupAsset> BubbleAsset;
}

enum TanoombaState : Byte {
    Idling,
	Searching,
	Attacking,
	KnockedBack,
	Transformed,
	Happy,
	Laughing,
	Shocked,
}

event TanoombaFlee {
	EntityRef Entity;
}
event TanoombaAttack {
	EntityRef Entity;
}
event TanoombaLMAO {
	EntityRef Entity;
}
event TanoombaPoof {
	EntityRef Entity;
}

event TanoombaTransform {
	Frame f;
	EntityRef Entity;
	int FormId;
}

event TanoombaPlaySoundType {
	EntityRef Entity;
	int SoundId;
}