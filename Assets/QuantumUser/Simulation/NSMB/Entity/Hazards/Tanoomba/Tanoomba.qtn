component Tanoomba {
	[ExcludeFromPrototype] TanoombaState State;
	[ExcludeFromPrototype] TanoombaFormState Form;
	FP JumpVelocity;
	
	[ExcludeFromPrototype] int HitFrame;
	[ExcludeFromPrototype] byte GetupFrames;
	[ExcludeFromPrototype] byte LastKnockback;
	[ExcludeFromPrototype] byte DamageInvincibilityFrames;

	[ExcludeFromPrototype] EntityRef TargetPlayer;
	[ExcludeFromPrototype] EntityRef TargetCoin;
	[ExcludeFromPrototype] FPVector2 TargetBlock; //Idk What To Do here yet

	[ExcludeFromPrototype] bool Laughing;
}

enum TanoombaState : Byte {
    Idling,
	Searching,
	Attacking,
	KnockedBack,
	Transformed,
}

enum TanoombaFormState : Byte {
	//General
	Coin,
	Block,
	Star,
	Goomba,
	KoopaShell,

	//Hazards
	HeavyStone,
	LemmyBall, //make stars be tanoomba's face

	//Edge
	Max,
}

