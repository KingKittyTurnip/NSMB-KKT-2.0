#define _0_875 0.875

component Tanoomba {
	[ExcludeFromPrototype] TanoombaState State;
	[ExcludeFromPrototype] TanoombaFormState Form;
	[ExcludeFromPrototype] byte FormVariant;
	FP JumpVelocity;
	
	[ExcludeFromPrototype] FP ReusableTimer;

	[ExcludeFromPrototype] EntityRef TransformedObject;
	[ExcludeFromPrototype] EntityRef TargetedPlayer;
	
	//[ExcludeFromPrototype] bool Laughing;
	[ExcludeFromPrototype] bool PlayerPassedBy;
	[ExcludeFromPrototype] bool Invulnrable;
}

enum TanoombaState : Byte {
    Idling,
	Searching,
	Attacking,
	KnockedBack,
	Transformed,
	Happy,
	Laughing,
	Shocked,
}

enum TanoombaFormState : Byte {
	//General
	Coin,
	Block,
	Star,
	Powerup,

	//Stage Elements ig
	Goomba,
	KoopaShell,

	//Hazards
	HeavyStone,
	LemmyBall, //make stars be tanoomba's face

	//Edge
	Max,
}

event TanoombaFlee {
	EntityRef Entity;
}
event TanoombaAttack {
	EntityRef Entity;
}
event TanoombaLMAO {
	EntityRef Entity;
}
event TanoombaPoof {
	EntityRef Entity;
}