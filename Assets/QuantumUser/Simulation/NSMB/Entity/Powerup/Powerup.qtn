component Powerup {
	bool FacingRight;

	[ExcludeFromPrototype] FPVector2 AnimationCurveOrigin;
	[ExcludeFromPrototype] FP AnimationCurveTimer;
}

signal OnMarioPlayerCollectedPowerup(EntityRef mario, EntityRef powerup);

enum PowerupState : Byte {
    NoPowerup,
    MiniMushroom,
    Mushroom,
    FireFlower,
    IceFlower,
    PropellerMushroom,
    BlueShell,
	HammerSuit,
    MegaMushroom,
    BubbleFlower,
    Bombro,
    Bioflower,
    PocketDoor,
    e,
    MetalMushroom,
    Jumpsuit,
    Doneflower,
    FrostedCake,
    TurnipBasket,
    e2,
}

enum PowerupSpawnReason : Byte {
	PowerupBlock,
	Coins,
	BlueKoopa,
	Other
}

enum PowerupReserveResult : Byte {
	KeepOldReserveNew,
    CollectNewReserveOld,
    CollectNewIgnoreOld,
}